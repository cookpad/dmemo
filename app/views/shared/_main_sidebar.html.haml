%aside.app-sidebar.shadow{ "data-bs-theme": "dark" }
  .sidebar-brand
    %a.brand-link{ href: root_path }
      %i.brand-image.fas.fa-home
      %span.brand-text
        %b> Database
        MEMO

  - if current_user
    .user-panel.d-flex.align-items-center.flex-shrink-0.px-3.my-3
      = image_tag current_user.image_url, class: "rounded"
      %span.info.ms-2= current_user.name

  .sidebar-search{ role: "search" }
    = form_with model: @search_result, method: :get, local: true do |f|
      .input-group.input-group-sm
        = f.search_field :keyword, placeholder: "Search...", class: "form-control"
        %button.btn.rounded-end-pill{ name: "search", type: "submit", "aria-label": "Search" }
          %i.fas.fa-magnifying-glass

  .sidebar-wrapper
    %nav.mt-2{ "aria-label": "Main navigation" }
      %ul#navigation.nav.sidebar-menu.flex-column{ "data-lte-toggle": "treeview", "data-accordion": "false" }
        %li.nav-item
          = link_to root_path, class: "nav-link" do
            %i.nav-icon.fas.fa-home
            %p
              Home
        %li.nav-item
          = link_to users_path, class: "nav-link" do
            %i.nav-icon.fas.fa-user
            %p
              User
        %li.nav-item
          = link_to keywords_path, class: "nav-link" do
            %i.nav-icon.fas.fa-book
            %p
              Keyword
        %li.nav-item.menu-open
          %a.nav-link{ href: "#" }
            %i.nav-icon.fas.fa-database
            %p
              Database
              %i.nav-arrow.fas.fa-angle-right
          %ul.nav.nav-treeview
            - @sidebar_databases.map(&:name).each do |name|
              %li.nav-item
                = link_to database_memo_path(name), class: "nav-link" do
                  %i.nav-icon.far.fa-circle
                  %p
                    = name
